# ────────────────────────────────────────────────────────────────
# ตั้งค่าระบบ — คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ถ้ายังไม่ใส่อะไรเลย ระบบจะเก็บข้อมูลเป็นไฟล์ในเครื่อง (โหมดลองใช้)
# ────────────────────────────────────────────────────────────────

# กุญแจสำหรับเข้ารหัสการล็อกอิน — สุ่มมาอย่างน้อย 32 ตัวอักษร
# สร้างได้ด้วยคำสั่ง: openssl rand -base64 32
SESSION_SECRET=

# ── Firestore (ใส่ตอนพร้อมขึ้นออนไลน์จริง) ──
# เอามาจากไฟล์ JSON ที่ดาวน์โหลดจาก Firebase Console
GOOGLE_CLOUD_PROJECT=
FIRESTORE_CLIENT_EMAIL=
# ใส่ทั้งก้อนรวม -----BEGIN PRIVATE KEY----- โดยแทนการขึ้นบรรทัดใหม่ด้วย \n
FIRESTORE_PRIVATE_KEY=

# ── แจ้งเตือนเข้า LINE (ใส่ทีหลังได้) ──
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
